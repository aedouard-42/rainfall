#include <unistd.h>
#include <cstring>

class N {
public:
    char annotation[100];
    int nb;

    N(int val) : nb(val) {}

    virtual int operator+(N &right) { return this->nb + right.nb; }
    virtual int operator-(N &right) { return this->nb - right.nb; }

    void setAnnotation(char *str) {
        memcpy(this->annotation, str, strlen(str));
    }
};

int main(int argc, char** argv) {
    if (argc <= 1)
        _exit(1);

    N* obj1 = new N(5);
    N* obj2 = new N(6);

    obj1->setAnnotation(argv[1]);

    return obj2->operator+(*obj1);
}