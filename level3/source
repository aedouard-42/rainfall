#include <stdio.h>
#include <stdlib.h>

int target = 0; // the global variable to modify

void v(void)
{
	char	buffer[512];

	fgets(buffer, 0x200, stdin);
	printf(buffer);
	if (target == 0x40)
	{
		fwrite("Wait what?!\n", 1, 0xc, stdout);
		system("/bin/sh");
	}
	return 0;
}

int main(void)
{
	v();
	return 0;
}